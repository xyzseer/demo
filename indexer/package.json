{
  "name": "@seer-pm/indexer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "tsc --clean",
    "build": "tsc --build",
    "watch": "tsc --watch",
    "mocha": "ts-mocha test/**/*.ts",
    "codegen": "node scripts/build-config.mjs > config.yaml && envio codegen",
    "config:build": "node scripts/build-config.mjs > config.yaml",
